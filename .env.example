# MongoDB connection string. The database name is part of the URL.
MONGO_URL=mongodb://127.0.0.1:27017/citeticket_demo

# Signs the session cookie. Generate a fresh value per environment, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit the real value.
SESSION_SECRET=replace-with-a-long-random-string

# Switches on demo behaviour (banner, role login buttons, seed script). Keep off outside the demo.
DEMO_MODE=false

# Optional: base path the app is served under (default /citeticket)
# BASE_PATH=/citeticket

# Demo only: shared secret a scheduler sends (Authorization: Bearer <token>) to POST /citeticket/api/demo/reset
# for the nightly wipe-and-reseed. Use 16+ random characters; shorter values disable the endpoint.
# DEMO_RESET_TOKEN=
